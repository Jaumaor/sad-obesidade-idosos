# ============================================================================
# SENTINELA - Variáveis de Ambiente
# 
# IMPORTANTE: Este é um arquivo de EXEMPLO.
# Copie este arquivo para .env e preencha com os valores reais:
#   Copy-Item .env.example .env
#
# NUNCA versione o arquivo .env no Git (já está no .gitignore)
# ============================================================================

# ===== AMBIENTE =====
ENVIRONMENT=development

# ===== BANCO DE DADOS =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sad_obesidade
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# ===== MODELO DE ML =====
MODEL_VERSION=1.0.0

# ===== SEGURANÇA (Flask) =====
SECRET_KEY=troque-para-uma-chave-secreta-longa-e-aleatoria

# ===== E-MAIL (Gmail SMTP - alertas) =====
# Para usar Gmail: ative "App Passwords" em https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app_gmail
MAIL_DEFAULT_SENDER=SENTINELA <seu_email@gmail.com>

# ===== GEOCODIFICAÇÃO (OPCIONAL) =====
# GEOCODING_API_KEY=sua_api_key_aqui

# ===== LOGS =====
LOG_LEVEL=INFO
